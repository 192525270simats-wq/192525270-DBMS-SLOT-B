        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "X = np.array([[0, 0], [0, 1], [1, 0], [1, 1]])\n",
        "Y = np.array([[0], [1], [1], [0]])\n",
        "\n",
        "np.random.seed(1)\n",
        "\n",
        "W1 = np.random.randn(2, 4)\n",
        "W2 = np.random.randn(4, 1)\n",
        "\n",
        "lr = 0.5\n",
        "\n",
        "for i in range(5000):\n",
        "    H = 1 / (1 + np.exp(-np.dot(X, W1)))\n",
        "    O = 1 / (1 + np.exp(-np.dot(H, W2)))\n",
        "\n",
        "    error = Y - O\n",
        "\n",
        "    dO = error * O * (1 - O)\n",
        "    dH = np.dot(dO, W2.T) * H * (1 - H)\n",
        "\n",
        "    W2 += lr * np.dot(H.T, dO)\n",
        "    W1 += lr * np.dot(X.T, dH)\n",
        "\n",
        "print(\"Predicted Output:\")\n",
        "print(np.round(O))\n",
        "\n",
        "plt.plot(error)\n",
        "plt.title(\"Backpropagation Error\")\n",
        "plt.show()"
