        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "x = 5.0\n",
        "lr = 0.1\n",
        "epochs = 20\n",
        "\n",
        "# Gradient Descent\n",
        "w1 = 0.0\n",
        "gd = []\n",
        "\n",
        "for i in range(epochs):\n",
        "    grad = 2 * (w1 - x)\n",
        "    w1 = w1 - lr * grad\n",
        "    gd.append((w1 - x) ** 2)\n",
        "\n",
        "# SGD\n",
        "w2 = 0.0\n",
        "sgd = []\n",
        "\n",
        "for i in range(epochs):\n",
        "    grad = 2 * (w2 - x)\n",
        "    w2 = w2 - lr * grad\n",
        "    sgd.append((w2 - x) ** 2)\n",
        "\n",
        "# Momentum\n",
        "w3 = 0.0\n",
        "v = 0.0\n",
        "momentum = []\n",
        "\n",
        "for i in range(epochs):\n",
        "    grad = 2 * (w3 - x)\n",
        "    v = 0.9 * v + lr * grad\n",
        "    w3 = w3 - v\n",
        "    momentum.append((w3 - x) ** 2)\n",
        "\n",
        "# Adam\n",
        "w4 = 0.0\n",
        "m = 0\n",
        "v = 0\n",
        "adam = []\n",
        "\n",
        "for i in range(1, epochs + 1):\n",
        "    grad = 2 * (w4 - x)\n",
        "    m = 0.9 * m + 0.1 * grad\n",
        "    v = 0.999 * v + 0.001 * grad ** 2\n",
        "    w4 = w4 - lr * (m / (1 - 0.9 ** i)) / (np.sqrt(v / (1 - 0.999 ** i)) + 1e-8)\n",
        "    adam.append((w4 - x) ** 2)\n",
        "\n",
        "plt.plot(gd, label=\"GD\")\n",
        "plt.plot(sgd, label=\"SGD\")\n",
        "plt.plot(momentum, label=\"Momentum\")\n",
        "plt.plot(adam, label=\"Adam\")\n",
        "plt.legend()\n",
        "plt.title(\"Optimizer Comparison\")\n",
        "plt.show()"
